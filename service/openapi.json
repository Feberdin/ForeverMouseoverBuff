{
  "openapi": "3.1.0",
  "info": {
    "title": "FMB Community-Ranking",
    "version": "0.2.0",
    "description": "Lokaler Prototyp. Alle Spieleridentitäten und Ereignisse sind self_reported, keine Spielserver-Bestätigung. Keine Empfängerdaten oder Summenimporte. JSON maximal32768Bytes, keine Extrafelder."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:18449"
    }
  ],
  "paths": {
    "/v1/participants": {
      "post": {
        "summary": "Freiwillige Anmeldung einer selbst angegebenen Identität",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Enrollment"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Erfolg",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Participant"
                }
              }
            }
          },
          "400": {
            "description": "Fester Fehlercode; vollständiger Batch wird bei 400/409 zurückgerollt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
