    "/v1/leaderboard": {
      "get": {
        "summary": "Unverifizierte Community-Zahlen, Quarantäne ausgeschlossen",
        "parameters": [
          {
            "name": "group",
            "in": "query",
            "schema": {
              "enum": [
                "players",
                "classes",
                "buffs"
              ],
              "default": "players"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "class",
            "in": "query",
            "schema": {
              "enum": [
                "PALADIN"
              ]
            }
          },
          {
            "name": "buff",
            "in": "query",
            "schema": {
              "enum": [
                "might",
                "wisdom",
                "kings"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Erfolg",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Leaderboard"
                }
              }
            }
          },
          "400": {
            "description": "Fester Fehlercode; vollständiger Batch wird bei 400/409 zurückgerollt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Fester Fehlercode; vollständiger Batch wird bei 400/409 zurückgerollt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Fester Fehlercode; vollständiger Batch wird bei 400/409 zurückgerollt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Fester Fehlercode; vollständiger Batch wird bei 400/409 zurückgerollt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Fester Fehlercode; vollständiger Batch wird bei 400/409 zurückgerollt",
            "content": {
              "application/json": {
