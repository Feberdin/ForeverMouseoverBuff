    "/health": {
      "get": {
        "summary": "Dienststatus ohne Datenbank- oder Teilnehmerdaten",
        "responses": {
          "200": {
            "description": "Erfolg",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
